---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import PartnersMarquee from '@/components/PartnersMarquee.astro';
import SessionCard from '@/components/SessionCard.astro';
import MinicursoCard from '@/components/MinicursoCard.astro';
import SessionModal from '@/components/SessionModal.astro';
import MinicursoModal from '@/components/MinicursoModal.astro';
import CTASection from '@/components/CTASection.astro';
import Footer from '@/components/Footer.astro';
import {
  getEventInfo,
  getFeaturedSessions,
  getMinicursos,
  getPartners,
  getSessionsWithSpeakers,
  getTurmas,
  scheduleKey,
} from '@/lib/data';
import type { Minicurso, SessionWithSpeakers } from '@/lib/types';

// Desativa o cache HTTP na Vercel e navegadores para forçar renderização em tempo real
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate, max-age=0');

const event = await getEventInfo();

// Com o evento oculto, a home mostra só o Hero e a chamada: não precisa buscar o resto
const [partners, sessions, minicursos, turmas] = event.eventoAtivo
  ? await Promise.all([getPartners(), getSessionsWithSpeakers(), getMinicursos(), getTurmas()])
  : [[], [], [], []];

type Destaque =
  | { tipo: 'palestra'; date: string; timeStart: string; session: SessionWithSpeakers }
  | { tipo: 'minicurso'; date: string; timeStart: string; minicurso: Minicurso };

// Próximas atividades: palestras que ainda não terminaram + minicursos que ainda não começaram
const MAX_DESTAQUES = 3;
const proximasPalestras = await getFeaturedSessions(sessions, MAX_DESTAQUES);
const destaques: Destaque[] = [
  ...proximasPalestras.map((session) => ({
    tipo: 'palestra' as const,
    date: session.date,
    timeStart: session.timeStart,
    session,
  })),
  ...minicursos
    .filter((m) => !m.encerrado)
    .map((minicurso) => ({
      tipo: 'minicurso' as const,
      date: minicurso.date,
      timeStart: minicurso.timeStart,
      minicurso,
    })),
]
  .sort((a, b) => scheduleKey(a).localeCompare(scheduleKey(b)))
  .slice(0, MAX_DESTAQUES);

const pageTitle = event.editionShort ? `Semana de Tecnologia — SETEC ${event.editionShort}` : 'Semana de Tecnologia — SETEC';
---

<Layout title={pageTitle} event={event}>
  <Hero event={event} />

  {/* Oculta o carrossel e a seção de destaques se o evento estiver oculto */}
  {
    event.eventoAtivo && (
      <>
        <PartnersMarquee partners={partners} />

        <section id="palestrantes" class="mx-auto max-w-6xl px-6 py-16">
          <div class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
            <div>
              <h2 class="font-display text-3xl font-bold uppercase text-[var(--text-primary)] sm:text-4xl">
                Programação<br />em destaque
              </h2>
            </div>
            <a
              href="/programacao"
              class="inline-flex items-center gap-2 rounded-full border border-[var(--border-color)] px-5 py-2.5 text-sm font-medium text-[var(--text-primary)] transition-colors hover:border-accent hover:text-accent [.light_&]:hover:text-violet-700"
            >
              Ver Programação Completa →
            </a>
          </div>

          <p class="mb-6 flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-[var(--text-secondary)]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5" aria-hidden="true">
              <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.6" />
              <path d="M12 8v4l2.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Próximas atividades
          </p>

          {
            destaques.length > 0 ? (
              <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {destaques.map((item) =>
                  item.tipo === 'palestra' ? (
                    <SessionCard session={item.session} speakers={item.session.speakers} showDay />
                  ) : (
                    <MinicursoCard minicurso={item.minicurso} showDay />
                  ),
                )}
              </div>
            ) : (
              <p class="py-8 text-left text-sm text-[var(--text-secondary)]">
                Nenhuma palestra ou minicurso agendado para os próximos horários.
              </p>
            )
          }
        </section>

        <SessionModal sessions={proximasPalestras} editionTag={event.siteName} />
        <MinicursoModal minicursos={destaques.flatMap((d) => (d.tipo === 'minicurso' ? [d.minicurso] : []))} turmas={turmas} />
      </>
    )
  }

  <CTASection event={event} temMinicursos={minicursos.length > 0} />
  <Footer event={event} />
</Layout>
