---
import Layout from '@/layouts/Layout.astro';
import Footer from '@/components/Footer.astro';
import Logo from '@/components/Logo.astro';
import { getEventInfo } from '@/lib/data';

const event = await getEventInfo();
---

<Layout title={`Página não encontrada — ${event.siteName}`} event={event}>
  <main class="relative mx-auto flex min-h-[70vh] max-w-4xl flex-col items-center justify-center overflow-hidden px-6 pt-10 text-center">
    <div
      class="pointer-events-none absolute left-1/2 top-1/3 h-[320px] w-[320px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent/25 blur-[120px]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mb-10">
      <Logo event={event} />
    </div>

    <p class="relative font-display text-[6rem] font-bold leading-none tracking-tight text-[var(--text-primary)] sm:text-[9rem]">
      404
    </p>
    <h1 class="relative mt-4 font-display text-2xl font-bold uppercase text-[var(--text-primary)] sm:text-3xl">
      Página não encontrada
    </h1>
    <p class="relative mt-4 max-w-md text-sm text-[var(--text-secondary)] sm:text-base">
      O endereço que você acessou não existe ou foi movido.
    </p>

    <div class="relative mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold uppercase tracking-wide text-white transition-transform hover:-translate-y-0.5"
      >
        Voltar ao início
      </a>
      {
        event.eventoAtivo && (
          <a
            href="/programacao"
            class="inline-flex items-center gap-2 rounded-full border border-[var(--border-color)] px-6 py-3 text-sm font-semibold uppercase tracking-wide text-[var(--text-primary)] transition-colors hover:border-accent"
          >
            Ver programação →
          </a>
        )
      }
    </div>
  </main>

  <Footer event={event} />
</Layout>
