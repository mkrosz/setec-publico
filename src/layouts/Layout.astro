---
import '@/styles/global.css';
import BottomNav from '@/components/BottomNav.astro';
import { getEventInfo } from '@/lib/data';
import type { EventInfo } from '@/lib/types';

interface Props {
  title: string;
  description?: string;
  /** Dados do evento já carregados pela página (evita consultar de novo). */
  event?: EventInfo;
}

const event = Astro.props.event ?? (await getEventInfo());
const defaultDescription =
  ['Semana de Tecnologia', event.editionLabel, event.institution].filter(Boolean).join(' — ') + '.';
const { title, description = defaultDescription } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Tema antes da pintura: padrão escuro; 'setec-theme' guarda a escolha (migra a chave antiga 'theme') -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = null;
        try {
          theme = localStorage.getItem('setec-theme');
          var old = localStorage.getItem('theme');
          if (!theme && (old === 'light' || old === 'dark')) {
            theme = old;
            localStorage.setItem('setec-theme', old);
          }
          if (old !== null) localStorage.removeItem('theme');
        } catch (e) {}
        if (theme === 'light') {
          root.classList.remove('dark');
          root.classList.add('light');
        }
      })();
    </script>
    <link rel="icon" type="image/png" href="/logo-mascote.png" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="relative min-h-screen pb-24 selection:bg-accent">
    <slot />

    <BottomNav event={event} />
  </body>
</html>
