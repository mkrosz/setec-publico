---
import type { EventInfo } from '@/lib/types';

interface Props {
  event: EventInfo & { 
    symplaUrl?: string; 
    instagramUrl?: string; 
  };
}

const { event } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 py-10">
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    {/* Card Principal: Chamada e Inscrição */}
    <div
      class="relative flex flex-col justify-between overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] dark:bg-gradient-to-br dark:from-neutral-800/70 dark:via-base-900 dark:to-black p-8 lg:col-span-2"
    >
      <div class="relative">
        <span
          class="mb-6 inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-emerald-600 dark:text-emerald-300"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400"></span>
          Inscrições Abertas
        </span>

        <h2
          class="max-w-lg font-display text-2xl font-normal uppercase leading-tight text-[var(--text-primary)] sm:text-4xl"
        >
          Garanta seu lugar no maior evento tech da região.
        </h2>

        <p class="mt-4 max-w-md text-sm text-[var(--text-secondary)] sm:text-base">
          Vagas limitadas para os workshops presenciais. Garanta agora pelo Sympla e receba
          acesso antecipado aos materiais.
        </p>
      </div>

      {/* Botão com Link do Sympla vindo do Dashboard */}
      <a 
        href={event.symplaUrl || "https://www.sympla.com.br"} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="relative mt-8 inline-flex w-fit items-center gap-2 rounded-full bg-[#ded9f7] px-6 py-3 text-sm font-semibold uppercase tracking-wide text-base-950 transition-transform hover:-translate-y-0.5"
      >
        <span class="text-base-950">Adquira no Sympla</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-base-950">
          <path
            d="M7 17 17 7M17 7H9M17 7v8"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    {/* Coluna Direita: Datas e Redes Sociais */}
    <div class="flex flex-col gap-5">
      {/* Card de Datas Vindas do Dashboard */}
      <div class="rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="mb-4 h-7 w-7 text-accent-soft">
          <path
            d="M7 3v3M17 3v3M4 8.5h16M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <h3 class="font-display text-xl font-normal text-[var(--text-primary)]">{event.dateRangeLabel}</h3>
        <p class="mt-2 text-sm text-[var(--text-secondary)]">{event.dateRangeDescription}</p>
      </div>

      {/* Card do Instagram vindo do Dashboard */}
      <div class="relative overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-6">
        <img
          src="/logo-mascote.png"
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -bottom-0 -right-2 w-36 opacity-100 sm:w-40"
        />

        <div class="relative">
          <span class="mb-4 block text-2xl font-medium leading-none text-accent-soft">@</span>
          <h3 class="font-display text-xl font-normal text-[var(--text-primary)]">Siga nas Redes</h3>
          <p class="mt-2 text-sm text-[var(--text-secondary)]">Acompanhe a cobertura do evento.</p>
          <a 
            href={event.instagramUrl || "https://www.instagram.com"} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="mt-3 inline-block text-sm font-medium text-accent-soft transition-transform hover:-translate-y-0.5"
          >
            Acessar Instagram ↗
          </a>
        </div>
      </div>
    </div>
  </div>
</section>