---
import Logo from '@/components/Logo.astro';
import { getEventInfo } from '@/lib/data';
import type { EventInfo } from '@/lib/types';

interface Props {
  event?: EventInfo;
  eventAtivo?: boolean;
}

const event = Astro.props.event ?? (await getEventInfo());
const { eventAtivo = event.eventoAtivo } = Astro.props;
const currentYear = event.ano || new Date().getFullYear();
const link = 'transition-colors hover:text-[var(--text-primary)]';
---

<footer class="mx-auto max-w-6xl px-6 pb-16 pt-10">
  <div
    class="flex flex-col items-center justify-between gap-6 border-t border-[var(--border-color)] pt-8 sm:flex-row"
  >
    <Logo event={event} />

    <nav aria-label="Rodapé" class="flex flex-wrap items-center justify-center gap-6 text-sm text-[var(--text-secondary)]">
      <a href="/" class={link}>Início</a>
      {eventAtivo && <a href="/#palestrantes" class={link}>Palestrantes</a>}
      {eventAtivo && <a href="/programacao" class={link}>Programação</a>}
      {
        event.symplaUrl && (
          <a href={event.symplaUrl} target="_blank" rel="noopener noreferrer" class={link}>
            Inscrição
          </a>
        )
      }
      {
        event.instagramUrl && (
          <a href={event.instagramUrl} target="_blank" rel="noopener noreferrer" class={link}>
            Instagram
          </a>
        )
      }
      <a href="/privacidade" class={link}>Privacidade e Informações</a>
      <a href="/comissao" class={link}>Comissão</a>
      <a
        href="/privacidade#apoio"
        class="rounded-full border border-accent/40 bg-accent/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent transition-colors hover:bg-accent hover:text-black [.light_&]:text-violet-700 [.light_&]:hover:text-white"
      >
        <span aria-hidden="true">🤝</span> Seja um Apoiador
      </a>
    </nav>
  </div>

  <p class="mt-6 text-center text-xs text-[var(--text-secondary)] sm:text-right">
    © {currentYear} {event.siteName}. Todos os direitos reservados.
    <span class="ml-2 text-[10px] opacity-20" title="mkrosz">
      · by <a href="https://www.linkedin.com/in/mike-franguelli" target="_blank" rel="noopener noreferrer" class="transition-opacity hover:opacity-100">mkrosz</a>
    </span>
  </p>
</footer>
