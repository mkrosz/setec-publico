---
import type { Session, Speaker } from '@/lib/types';

interface Props {
  session: Session;
  speaker: Speaker;
}

const { session, speaker } = Astro.props;
---

<button
  type="button"
  data-session-trigger={session.id}
  data-session-card
  data-date={session.date}
  data-time-end={session.timeEnd}
  class="group relative flex aspect-[3/4] w-full flex-col overflow-hidden rounded-2xl border border-white/5 text-left shadow-card transition-transform duration-300 hover:-translate-y-1 hover:border-white/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
>
  <!-- Foto preenche o card inteiro, de ponta a ponta -->
  <img
    src={speaker.photoUrl}
    alt={speaker.name}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
  />

  <!-- Sombra/degradê para dar legibilidade ao texto sobreposto -->
  <div
    class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/5"
    aria-hidden="true"
  >
  </div>

  <span
    class="absolute left-4 top-4 rounded-full border border-white/15 bg-black/40 px-3 py-1 text-xs font-semibold tracking-wide text-white backdrop-blur-sm"
  >
    {session.highlightNumber || '#'}
  </span>

  <!-- Conteúdo flutua sobre a imagem, ancorado na base do card -->
  <div class="relative mt-auto flex flex-col gap-3 p-5">
    <span class="text-xs font-medium uppercase tracking-widest text-accent-soft">
      {session.track}
    </span>

    <div>
      <h3 class="font-display text-lg font-semibold text-white">{speaker.name}</h3>
      <p class="mt-1 text-sm text-white/60">{session.title}</p>
    </div>

    <div class="flex items-center justify-between border-t border-white/15 pt-4">
      <span class="text-sm font-medium text-white/70">{session.timeStart}</span>
      <span
        class="flex h-8 w-8 items-center justify-center rounded-lg border border-white/15 bg-black/20 text-white/70 backdrop-blur-sm transition-colors group-hover:border-accent group-hover:text-accent"
        aria-hidden="true"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-3.5 w-3.5">
          <path
            d="M7 17 17 7M17 7H9M17 7v8"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</button>