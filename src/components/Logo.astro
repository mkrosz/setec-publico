---
import { getEventInfo } from '@/lib/data';
import type { EventInfo } from '@/lib/types';

interface Props {
  event?: EventInfo;
  /** Classes extras; quando informada, substitui o display padrão (inline-flex). */
  class?: string;
}

const { class: className } = Astro.props;
const event = Astro.props.event ?? (await getEventInfo());
---

<a
  href="/"
  aria-label="SETEC — página inicial"
  class:list={['items-center gap-3 transition-opacity hover:opacity-90', className || 'inline-flex']}
>
  {
    event.logoUrl ? (
      <img
        src={event.logoUrl}
        alt="Logo SETEC"
        class="h-10 w-auto max-w-[180px] object-contain transition-all [.light_&]:invert dark:invert-0"
      />
    ) : (
      <div class="font-display leading-tight">
        <span class="block text-[9px] tracking-[0.22em] text-[var(--text-secondary)]">SEMANA DE</span>
        <span class="block text-base font-extrabold text-[var(--text-primary)]">TECNOLOGIA</span>
        {event.editionLabel && (
          <span class="block text-[9px] tracking-[0.2em] text-accent [.light_&]:text-violet-700">{event.editionLabel}</span>
        )}
      </div>
    )
  }
</a>
