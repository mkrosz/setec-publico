---
import { getAllSessionsWithSpeakers } from '@/lib/data';

const sessionsWithSpeakers = await getAllSessionsWithSpeakers();
---

<div
  id="session-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  data-state="closed"
>
  <div
    id="session-modal-backdrop"
    class="absolute inset-0 bg-black/70 [.light_&]:bg-slate-200/70 backdrop-blur-sm"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 w-full max-w-3xl animate-scaleIn">
    <div
      id="session-modal-panel"
      class="relative max-h-[calc(100vh-7rem)] w-full overflow-y-auto rounded-2xl border border-[var(--border-color)] bg-[#111113] [.light_&]:bg-white shadow-2xl xl:max-h-[90vh]"
    >

    <button
      type="button"
      id="session-modal-close"
      aria-label="Fechar"
      class="absolute right-5 top-5 z-20 flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border-color)] bg-white/10 text-[var(--text-secondary)] backdrop-blur-sm transition-colors hover:bg-white/20 [.light_&]:bg-black/5 [.light_&]:hover:bg-black/10"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- ROW 1: foto + título/nome/cargo/tags -->
    <div class="grid grid-cols-1 gap-6 p-6 pb-0 sm:grid-cols-[220px_1fr] sm:gap-8 sm:p-8 sm:pb-0">
      <div id="modal-photo-container" class="relative h-[220px] w-[220px] overflow-hidden rounded-xl border border-[var(--border-color)]">
        <!-- Fotos serão inseridas aqui dinamicamente -->
      </div>

      <div>
        <h2 id="modal-title" class="font-display text-2xl font-bold uppercase leading-tight text-[var(--text-primary)] sm:text-3xl"></h2>

        <p id="modal-speaker-name" class="mt-4 text-lg font-semibold text-[var(--text-primary)]"></p>
        <p id="modal-speaker-role" class="text-sm text-[var(--text-secondary)]"></p>

        <!-- Tags -->
        <div class="mt-4 flex flex-wrap items-center gap-2" id="modal-tags"></div>
      </div>
    </div>

    <!-- ROW 2: metadados -->
    <div class="mx-6 flex flex-wrap items-center gap-x-3 gap-y-2 py-5 text-sm text-[var(--text-secondary)] sm:mx-8">
      <span class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-accent-soft">
          <path d="M7 3v3M17 3v3M4 8.5h16M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span id="modal-date"></span>
      </span>
      <span class="text-white/25" aria-hidden="true">•</span>
      <span class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-accent-soft">
          <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 8v4l2.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span id="modal-time"></span>
      </span>
      <span class="text-white/25" aria-hidden="true">•</span>
      <span class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-accent-soft">
          <path d="M12 21s7-6.1 7-11.5a7 7 0 1 0-14 0C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          <circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.6"></circle>
        </svg>
        <span id="modal-location"></span>
      </span>
    </div>

    <!-- ROW 3: Sobre a Palestra / Sobre o Palestrante -->
    <div class="grid grid-cols-1 gap-8 border-t border-[var(--border-color)] p-6 sm:grid-cols-2 sm:p-8">
      <div>
        <h3 class="mb-3 flex items-center gap-2 font-display text-base font-semibold text-accent-soft">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
            <path d="M6 3.5h9l3 3V20a.5.5 0 0 1-.5.5H6a.5.5 0 0 1-.5-.5V4a.5.5 0 0 1 .5-.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
            <path d="M9 12h6M9 15.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          Sobre a Palestra
        </h3>
        <p id="modal-description" class="text-sm leading-relaxed text-[var(--text-secondary)]"></p>
      </div>

      <div>
        <h3 class="mb-3 flex items-center gap-2 font-display text-base font-semibold text-accent-soft">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
            <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          Sobre <span id="modal-about-label">o Palestrante</span>
        </h3>
        <p id="modal-bio" class="text-sm leading-relaxed text-[var(--text-secondary)]"></p>
      </div>
    </div>
  </div>
  <!-- Links: ao lado do modal no desktop, abaixo dele em telas menores -->
  <div
    id="modal-links"
    class="mt-3 flex flex-wrap justify-center gap-2 xl:absolute xl:left-full xl:top-6 xl:ml-3 xl:mt-0 xl:flex-col xl:items-start xl:justify-start"
  ></div>
</div>
</div>

<script type="application/json" id="sessions-data" set:html={JSON.stringify(sessionsWithSpeakers)}></script>

<script>
  interface SpeakerData {
    id: string;
    name: string;
    role: string;
    company: string;
    photoUrl: string | string[];
    bio: string;
  }
  interface SessionData {
    id: string;
    title: string;
    category: string;
    editionTag: string;
    dayLabel: string;
    timeStart: string;
    timeEnd: string;
    location: string;
    description: string;
    speakers: SpeakerData[];
  }
    interface LinkData {
    type: string;
    url: string;
  }
  interface SessionData {
    // ...campos existentes
    speakers: SpeakerData[];
    links?: LinkData[];
  }

  const dataEl = document.getElementById('sessions-data');
  const sessions: SessionData[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const modal = document.getElementById('session-modal') as HTMLDivElement | null;
  const backdrop = document.getElementById('session-modal-backdrop');
  const closeBtn = document.getElementById('session-modal-close');
  const panel = document.getElementById('session-modal-panel');
  let modalInterval: ReturnType<typeof setInterval> | null = null;

  const ICON_BASE =
  'xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"';

  const LINK_META: Record<string, { name: string; icon: string }> = {
    linkedin: {
      name: 'LinkedIn',
      icon: `<svg ${ICON_BASE}><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`,
    },
    instagram: {
      name: 'Instagram',
      icon: `<svg ${ICON_BASE}><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>`,
    },
    github: {
      name: 'GitHub',
      icon: `<svg ${ICON_BASE}><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>`,
    },
    facebook: {
      name: 'Facebook',
      icon: `<svg ${ICON_BASE}><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>`,
    },
    twitter: {
      name: 'X / Twitter',
      icon: `<svg ${ICON_BASE}><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>`,
    },
    youtube: {
      name: 'YouTube',
      icon: `<svg ${ICON_BASE}><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>`,
    },
    site: {
      name: 'Site',
      icon: `<svg ${ICON_BASE}><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
    },
  };

  // Extrai uma legenda curta da URL: nome do perfil (redes) ou domínio (sites)
  function getLinkHandle(type: string, rawUrl: string): string {
    try {
      const url = new URL(rawUrl);
      const host = url.hostname.replace(/^www\./i, '');
      const parts = url.pathname.split('/').filter(Boolean);

      if (type === 'site') return host;

      let handle = '';
      if (type === 'linkedin') {
        // /in/nome-do-perfil ou /company/nome-da-empresa
        const i = parts.findIndex((p) => ['in', 'company', 'school'].includes(p));
        handle = i >= 0 ? (parts[i + 1] ?? '') : (parts[0] ?? '');
      } else if (type === 'youtube') {
        // /@canal, /c/canal, /channel/id, /user/nome
        handle = parts[0]?.startsWith('@') ? parts[0] : (parts[1] ?? parts[0] ?? '');
      } else {
        // instagram, github, facebook, twitter: primeiro trecho do caminho
        handle = parts[0] ?? '';
      }

      handle = decodeURIComponent(handle).replace(/^@/, '');
      if (!handle) return '';

      const comArroba = ['instagram', 'twitter', 'youtube'].includes(type);
      return comArroba ? `@${handle}` : handle;
    } catch {
      return '';
    }
  }

  function renderLinks(links: LinkData[] = []) {
    const container = document.getElementById('modal-links');
    if (!container) return;
    container.innerHTML = '';

    links.forEach((link) => {
      const meta = LINK_META[link.type] ?? LINK_META.site;
      const handle = getLinkHandle(link.type, link.url);
      const accessibleName = handle ? `${meta.name}: ${handle}` : meta.name;

      const a = document.createElement('a');
      a.href = link.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.title = link.url; // tooltip sempre mostra a URL completa
      a.setAttribute('aria-label', accessibleName);
      a.className =
        'link-chip group flex h-11 items-center overflow-hidden rounded-xl border border-white/15 bg-[#111113] text-white/80 shadow-lg transition-colors duration-300 hover:border-white/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/40 [.light_&]:border-black/10 [.light_&]:bg-white [.light_&]:text-slate-700 [.light_&]:hover:border-black/25 [.light_&]:focus-visible:ring-black/30';

      const iconBox = document.createElement('span');
      iconBox.className = 'flex h-11 w-11 shrink-0 items-center justify-center';
      iconBox.innerHTML = meta.icon; // SVG fixo definido acima, não vem do banco

      // Estrutura da animação: reveal (grid 0fr → 1fr) > clip (corta) > text (conteúdo real)
      const reveal = document.createElement('span');
      reveal.className = 'link-reveal';

      const clip = document.createElement('span');
      clip.className = 'link-clip';

      const text = document.createElement('span');
      text.className = 'link-text flex flex-col justify-center pr-4 leading-tight';

      const name = document.createElement('span');
      name.className = 'whitespace-nowrap text-sm font-medium';
      name.textContent = meta.name;
      text.append(name);

      if (handle) {
        const sub = document.createElement('span');
        sub.className = 'mt-0.5 truncate text-[11px] text-white/50 [.light_&]:text-slate-500';
        sub.textContent = handle; // textContent evita injeção de HTML
        text.append(sub);
      }

      clip.append(text);
      reveal.append(clip);
      a.append(iconBox, reveal);
      container.appendChild(a);
    });
  }

  function fillModal(session: SessionData) {
    const primary = session.speakers && session.speakers.length > 0 ? session.speakers[0] : null;
    const hasMultiple = session.speakers && session.speakers.length > 1;

    // Tags
    const tagsEl = document.getElementById('modal-tags')!;
    tagsEl.innerHTML = `
      <span class="rounded-full border border-[var(--border-color)] bg-[var(--card-bg)] px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-[var(--text-primary)]">#${session.category || 'PALESTRA'}</span>
      <span class="rounded-full border border-[var(--border-color)] bg-[var(--card-bg)] px-2.5 py-1 text-[11px] font-medium uppercase tracking-wide text-[var(--text-secondary)]">${session.editionTag || 'SETEC XXXIII'}</span>
    `;

    // Título da Palestra
    document.getElementById('modal-title')!.textContent = session.title || '';

    // Links (redes sociais / sites)
    renderLinks(session.links);

    // Nome do Palestrante
    document.getElementById('modal-speaker-name')!.textContent = session.speakers.map(s => s.name).join(', ') || 'Palestrante Convidado';

    let roleCompany = '';
    if (hasMultiple) {
      roleCompany = session.speakers.map(s => s.role || s.company).filter(Boolean).join(' • ');
    } else if (primary) {
      if (primary.role && primary.company) {
        roleCompany = `${primary.role} @ ${primary.company}`;
      } else {
        roleCompany = primary.role || primary.company || '';
      }
    }
    document.getElementById('modal-speaker-role')!.textContent = roleCompany;

    // Data, Hora e Local
    document.getElementById('modal-date')!.textContent = session.dayLabel || '';
    document.getElementById('modal-time')!.textContent = `${session.timeStart || ''} - ${session.timeEnd || ''}`;
    document.getElementById('modal-location')!.textContent = session.location || '';

    // Fotos Dinâmicas
    const container = document.getElementById('modal-photo-container')!;
    container.innerHTML = '';
    if (modalInterval) clearInterval(modalInterval);

    const allPhotos: string[] = session.speakers.flatMap((sp) =>
      Array.isArray(sp.photoUrl) ? sp.photoUrl : sp.photoUrl ? [sp.photoUrl] : []
    );

    if (allPhotos.length === 0) {
      container.innerHTML = `<div class="flex h-full w-full items-center justify-center bg-gray-800 text-xs text-white/50">Sem foto</div>`;
    } else {
      allPhotos.forEach((url, idx) => {
        const img = document.createElement('img');
        img.src = url;
        img.alt = session.title;
        img.className = `modal-slide-img absolute inset-0 h-full w-full object-cover object-top transition-opacity duration-700 ease-in-out ${idx === 0 ? 'opacity-100' : 'opacity-0'}`;
        container.appendChild(img);
      });

      if (allPhotos.length > 1) {
        let current = 0;
        const slides = container.querySelectorAll<HTMLImageElement>('.modal-slide-img');
        modalInterval = setInterval(() => {
          slides[current].classList.remove('opacity-100');
          slides[current].classList.add('opacity-0');

          current = (current + 1) % slides.length;

          slides[current].classList.remove('opacity-0');
          slides[current].classList.add('opacity-100');
        }, 3000);
      }
    }

    // Descrições
    document.getElementById('modal-description')!.textContent = session.description || '';
    document.getElementById('modal-about-label')!.textContent = hasMultiple ? 'os Palestrantes' : 'o Palestrante';

    document.getElementById('modal-bio')!.textContent = hasMultiple
      ? session.speakers.map((s) => `${s.name} — ${s.role || ''} ${s.company ? `@ ${s.company}` : ''}. ${s.bio || ''}`).join(' ')
      : (primary?.bio || 'Sem informações biográficas.');
  }

  function openModal(sessionId: string) {
    const session = sessions.find((s) => String(s.id) === String(sessionId));
    if (!session || !modal) return;
    fillModal(session);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.dataset.state = 'open';
    document.body.classList.add('modal-open');
  }

  function closeModal() {
    if (!modal) return;
    if (modalInterval) clearInterval(modalInterval);
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.dataset.state = 'closed';
    document.body.classList.remove('modal-open');
  }

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement)?.closest('[data-session-trigger]');
    if (trigger instanceof HTMLElement) {
      const id = trigger.dataset.sessionTrigger;
      if (id) openModal(id);
    }
  });

  backdrop?.addEventListener('click', closeModal);
  closeBtn?.addEventListener('click', closeModal);
  panel?.addEventListener('click', (e) => e.stopPropagation());

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.dataset.state === 'open') closeModal();
  });
</script>

<style>
  /* Barra de rolagem do modal: arredondada e afastada dos cantos */
  #session-modal-panel::-webkit-scrollbar {
    width: 14px;
  }

    /* ---------- Links do modal ---------- */

  /* Largura máxima do texto: abaixo do modal (telas menores) */
  #modal-links {
    --link-text-max: min(280px, calc(100vw - 7rem));
  }

  /* Ao lado do modal (xl): espaço livre à direita do modal,
     descontando margem, ícone, padding e uma folga */
  @media (min-width: 1280px) {
    #modal-links {
      --link-text-max: calc((100vw - 48rem) / 2 - 6rem);
    }
  }

  /* Anima até a largura exata do conteúdo, sem limite fixo */
  #modal-links :global(.link-reveal) {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  #modal-links :global(.link-chip:hover .link-reveal),
  #modal-links :global(.link-chip:focus-visible .link-reveal) {
    grid-template-columns: 1fr;
  }
  #modal-links :global(.link-clip) {
    min-width: 0;
    overflow: hidden;
  }
  #modal-links :global(.link-text) {
    width: max-content;
    max-width: var(--link-text-max);
  }

    @media (min-width: 1280px) {
    #modal-links {
      --link-text-max: calc((100vw - 48rem) / 2 - 6rem);
      width: max-content;
    }
  }
  #session-modal-panel::-webkit-scrollbar-track {
    background: transparent;
    /* maior que o raio do canto (rounded-2xl = 1.25rem) para a barra não encostar nas curvas */
    margin-block: 22px;
  }
  #session-modal-panel::-webkit-scrollbar-thumb {
    background-color: rgba(148, 163, 184, 0.55);
    border-radius: 999px;
    /* a borda transparente cria a folga lateral, deixando o thumb mais fino e afastado da borda */
    border: 4px solid transparent;
    background-clip: padding-box;
  }
  #session-modal-panel::-webkit-scrollbar-thumb:hover {
    background-color: rgba(148, 163, 184, 0.85);
  }

  /* Firefox não suporta margem na trilha, então usa a versão fina padrão */
  @supports not selector(::-webkit-scrollbar) {
    #session-modal-panel {
      scrollbar-width: thin;
      scrollbar-color: rgba(148, 163, 184, 0.6) transparent;
    }
  }
</style>