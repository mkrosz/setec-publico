---
import type { SessionWithSpeakers } from '@/lib/types';

interface Props {
  sessions: SessionWithSpeakers[];
  /** Ex.: "SETEC XXXIII" (vem da configuração do evento). */
  editionTag: string;
}

const { sessions, editionTag } = Astro.props;

// Só o que o modal usa, para não pesar o HTML
const modalData = sessions.map((s) => ({
  id: s.id,
  title: s.title,
  category: s.category,
  dayLabel: s.date ? s.dayLabel : '',
  timeStart: s.timeStart,
  timeEnd: s.timeEnd,
  location: s.location,
  description: s.description,
  links: (s.links ?? []).map((l) => ({ type: l.type, url: l.url })),
  speakers: s.speakers.map((sp) => ({
    name: sp.name,
    role: sp.role,
    company: sp.company,
    photoUrl: sp.photoUrl,
    bio: sp.bio,
  })),
}));
// "<" escapado: um texto com "</script>" não quebra a página
const modalJson = JSON.stringify(modalData).replace(/</g, '\\u003c');
---

<div
  id="session-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  data-state="closed"
  data-edition-tag={editionTag}
>
  <div
    id="session-modal-backdrop"
    class="absolute inset-0 bg-black/70 [.light_&]:bg-slate-200/70 backdrop-blur-sm"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 w-full max-w-4xl animate-scaleIn">
    <div
      id="session-modal-panel"
      class="modal-scroll relative max-h-[calc(100vh-7rem)] w-full overflow-y-auto rounded-2xl border border-[var(--border-color)] bg-[#111113] [.light_&]:bg-white shadow-2xl xl:max-h-[90vh]"
    >
    <button
      type="button"
      id="session-modal-close"
      aria-label="Fechar"
      class="absolute right-5 top-5 z-20 flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border-color)] bg-white/10 text-[var(--text-secondary)] backdrop-blur-sm transition-colors hover:bg-white/20 [.light_&]:bg-black/5 [.light_&]:hover:bg-black/10"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>

    <!-- ROW 1: foto + título/nome/cargo/tags -->
    <div class="grid grid-cols-1 gap-6 p-6 pb-0 sm:grid-cols-[220px_1fr] sm:gap-8 sm:p-8 sm:pb-0">
      <div id="modal-photo-container" class="relative h-[220px] w-[220px] overflow-hidden rounded-xl border border-[var(--border-color)]">
        <!-- Fotos serão inseridas aqui dinamicamente -->
      </div>

      <div>
        <h2 id="modal-title" class="pr-10 font-display text-2xl font-bold uppercase leading-tight text-[var(--text-primary)] sm:text-3xl"></h2>

        <p id="modal-speaker-name" class="mt-4 text-lg font-semibold text-[var(--text-primary)]"></p>
        <p id="modal-speaker-role" class="text-sm text-[var(--text-secondary)]"></p>

        <!-- Tags -->
        <div class="mt-4 flex flex-wrap items-center gap-2" id="modal-tags"></div>
      </div>
    </div>

    <!-- ROW 2: metadados -->
    <div class="mx-6 flex flex-wrap items-center gap-x-3 gap-y-2 py-5 text-sm text-[var(--text-secondary)] sm:mx-8">
      <span class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-accent-soft" aria-hidden="true">
          <path d="M7 3v3M17 3v3M4 8.5h16M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span id="modal-date"></span>
      </span>
      <span class="text-[var(--text-secondary)] opacity-50" aria-hidden="true">•</span>
      <span class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-accent-soft" aria-hidden="true">
          <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 8v4l2.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span id="modal-time"></span>
      </span>
      <span class="text-[var(--text-secondary)] opacity-50" aria-hidden="true">•</span>
      <span class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 text-accent-soft" aria-hidden="true">
          <path d="M12 21s7-6.1 7-11.5a7 7 0 1 0-14 0C5 14.9 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
          <circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.6"></circle>
        </svg>
        <span id="modal-location"></span>
      </span>
    </div>

    <!-- ROW 3: Sobre a palestra / Sobre o Palestrante -->
    <div class="grid grid-cols-1 gap-8 border-t border-[var(--border-color)] p-6 sm:grid-cols-2 sm:p-8">
      <div>
        <h3 class="mb-3 flex items-center gap-2 font-display text-base font-semibold text-accent-soft">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
            <path d="M6 3.5h9l3 3V20a.5.5 0 0 1-.5.5H6a.5.5 0 0 1-.5-.5V4a.5.5 0 0 1 .5-.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
            <path d="M9 12h6M9 15.5h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          Sobre a palestra
        </h3>
        <p id="modal-description" class="text-sm leading-relaxed text-[var(--text-secondary)]"></p>
      </div>

      <div>
        <h3 class="mb-3 flex items-center gap-2 font-display text-base font-semibold text-accent-soft">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"></circle>
            <path d="M5 20c0-3.3 3.1-6 7-6s7 2.7 7 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          <span>Sobre <span id="modal-about-label">o palestrante</span></span>
        </h3>
        <div id="modal-bio" class="space-y-5"></div>
      </div>
    </div>
  </div>
  <!-- Links: ao lado do modal no desktop, abaixo dele em telas menores -->
  <div
    id="modal-links"
    class="link-chips mt-3 flex flex-wrap justify-center gap-2 xl:absolute xl:left-full xl:top-6 xl:ml-3 xl:mt-0 xl:flex-col xl:items-start xl:justify-start"
  ></div>
</div>
</div>

<script type="application/json" id="sessions-data" set:html={modalJson}></script>

<script>
  import { createModalA11y } from '@/lib/modal-a11y';
  import { renderLinkChips, type LinkChipData } from '@/lib/link-chips';

  interface SpeakerData {
    name: string;
    role: string;
    company: string;
    photoUrl: string | string[];
    bio: string;
  }
  interface SessionData {
    id: string;
    title: string;
    category: string;
    dayLabel: string;
    timeStart: string;
    timeEnd: string;
    location: string;
    description: string;
    speakers: SpeakerData[];
    links?: LinkChipData[];
  }

  const dataEl = document.getElementById('sessions-data');
  const sessions: SessionData[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const modal = document.getElementById('session-modal') as HTMLDivElement | null;
  const closeBtn = document.getElementById('session-modal-close');
  const panel = document.getElementById('session-modal-panel');
  const linksBox = document.getElementById('modal-links');
  const editionTag = modal?.dataset.editionTag || 'SETEC';
  let modalInterval: ReturnType<typeof setInterval> | null = null;

  const a11y = createModalA11y({
    scopes: () => [panel, linksBox],
    initialFocus: () => closeBtn,
    onEscape: () => closeModal(),
  });

  function photosOf(sp: SpeakerData): string[] {
    return Array.isArray(sp.photoUrl) ? sp.photoUrl.filter(Boolean) : sp.photoUrl ? [sp.photoUrl] : [];
  }

  function joinNames(names: string[]): string {
    const list = names.map((n) => n.trim()).filter(Boolean);
    if (list.length <= 1) return list[0] ?? '';
    return `${list.slice(0, -1).join(', ')} e ${list[list.length - 1]}`;
  }

  function initials(name: string): string {
    const parts = name.trim().split(/\s+/).filter(Boolean);
    return `${parts[0]?.[0] ?? '?'}${parts[1]?.[0] ?? ''}`.toUpperCase();
  }

  // Um bloco por palestrante: foto, nome, cargo e bio (tudo via textContent)
  function renderBios(speakers: SpeakerData[]) {
    const container = document.getElementById('modal-bio');
    if (!container) return;
    container.innerHTML = '';

    if (speakers.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'text-sm leading-relaxed text-[var(--text-secondary)]';
      empty.textContent = 'Sem informações biográficas.';
      container.append(empty);
      return;
    }

    // Um palestrante: só a bio. Vários: abas (foto + nome) e a bio do selecionado,
    // assim o modal não cresce empilhando um bloco embaixo do outro.
    const panel = document.createElement('div');
    panel.id = 'modal-bio-panel';

    if (speakers.length > 1) {
      panel.setAttribute('role', 'tabpanel');
      const tabs = document.createElement('div');
      tabs.className = 'mb-4 flex flex-wrap gap-2';
      tabs.setAttribute('role', 'tablist');
      tabs.setAttribute('aria-label', 'Palestrantes');

      const buttons = speakers.map((sp, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.id = `modal-bio-tab-${i}`;
        btn.setAttribute('role', 'tab');
        btn.setAttribute('aria-controls', panel.id);
        btn.className =
          'bio-tab flex h-9 items-center gap-2 rounded-full border py-1 pl-1 pr-3.5 text-xs font-medium transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent';
        btn.append(avatarEl(sp, 'h-7 w-7 text-[10px]'));
        const label = document.createElement('span');
        label.className = 'whitespace-nowrap';
        label.textContent = sp.name.split(/\s+/).slice(0, 2).join(' ');
        btn.append(label);
        btn.addEventListener('click', () => select(i));
        btn.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();
          const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + speakers.length) % speakers.length;
          select(next);
          buttons[next].focus();
        });
        tabs.append(btn);
        return btn;
      });

      const select = (index: number) => {
        buttons.forEach((btn, i) => {
          const active = i === index;
          btn.setAttribute('aria-selected', String(active));
          btn.tabIndex = active ? 0 : -1;
          btn.classList.toggle('bio-tab-active', active);
        });
        panel.setAttribute('aria-labelledby', buttons[index].id);
        fillBioPanel(panel, speakers[index], true);
      };

      container.append(tabs, panel);
      select(0);
    } else {
      container.append(panel);
      fillBioPanel(panel, speakers[0], false);
    }
  }

  function avatarEl(sp: SpeakerData, size: string): HTMLSpanElement {
    const avatar = document.createElement('span');
    avatar.className = `flex ${size} shrink-0 items-center justify-center overflow-hidden rounded-full border border-[var(--border-color)] bg-[var(--card-bg)] font-semibold text-[var(--text-secondary)]`;
    const photo = photosOf(sp)[0];
    if (photo) {
      const img = document.createElement('img');
      img.src = photo;
      img.alt = '';
      img.loading = 'lazy';
      img.className = 'h-full w-full object-cover object-top';
      avatar.append(img);
    } else {
      avatar.textContent = initials(sp.name);
    }
    return avatar;
  }

  function fillBioPanel(panel: HTMLElement, sp: SpeakerData, withHeader: boolean) {
    panel.innerHTML = '';

    if (withHeader) {
      const head = document.createElement('div');
      head.className = 'mb-3 flex items-center gap-3';
      const info = document.createElement('div');
      info.className = 'min-w-0';
      const name = document.createElement('p');
      name.className = 'text-sm font-semibold text-[var(--text-primary)]';
      name.textContent = sp.name;
      info.append(name);
      const roleText = sp.role && sp.company ? `${sp.role} @ ${sp.company}` : sp.role || sp.company;
      if (roleText) {
        const role = document.createElement('p');
        role.className = 'text-xs text-[var(--text-secondary)]';
        role.textContent = roleText;
        info.append(role);
      }
      head.append(avatarEl(sp, 'h-11 w-11 text-xs'), info);
      panel.append(head);
    }

    const bio = document.createElement('p');
    bio.className = 'bio-text text-sm leading-relaxed text-[var(--text-secondary)]';
    bio.textContent = sp.bio || 'Sem informações biográficas.';
    panel.append(bio);

    // Corta em 6 linhas com "Ler mais" só se o texto tiver mais de 9 linhas; se o que
    // ficaria escondido for até 3 linhas, mostra tudo direto (mede com o modal visível)
    requestAnimationFrame(() => {
      const lineHeight = parseFloat(getComputedStyle(bio).lineHeight) || 22;
      if (Math.round(bio.scrollHeight / lineHeight) <= 9) return;
      bio.classList.add('line-clamp-6');
      const more = document.createElement('button');
      more.type = 'button';
      more.className = 'mt-2 text-xs font-semibold text-accent-soft transition-opacity hover:opacity-80';
      more.textContent = 'Ler mais';
      more.setAttribute('aria-expanded', 'false');
      more.addEventListener('click', () => {
        const expanded = bio.classList.toggle('line-clamp-6') === false;
        more.textContent = expanded ? 'Ler menos' : 'Ler mais';
        more.setAttribute('aria-expanded', String(expanded));
      });
      panel.append(more);
    });
  }

  function tagEl(text: string, extra: string): HTMLSpanElement {
    const tag = document.createElement('span');
    tag.className = `rounded-full border border-[var(--border-color)] bg-[var(--card-bg)] px-2.5 py-1 text-[11px] uppercase tracking-wide ${extra}`;
    tag.textContent = text; // textContent: categoria vem do banco
    return tag;
  }

  function fillModal(session: SessionData) {
    const primary = session.speakers && session.speakers.length > 0 ? session.speakers[0] : null;
    const hasMultiple = session.speakers && session.speakers.length > 1;

    // Tags
    document.getElementById('modal-tags')!.replaceChildren(
      tagEl(`#${session.category || 'PALESTRA'}`, 'font-semibold text-[var(--text-primary)]'),
      tagEl(editionTag, 'font-medium text-[var(--text-secondary)]'),
    );

    // Título da Palestra
    document.getElementById('modal-title')!.textContent = session.title || '';

    // Links (redes sociais / sites)
    renderLinkChips(linksBox, session.links);

    // Nome do(s) Palestrante(s)
    document.getElementById('modal-speaker-name')!.textContent =
      joinNames(session.speakers.map((s) => s.name)) || 'Palestrante convidado';

    let roleCompany = '';
    if (hasMultiple) {
      roleCompany = `${session.speakers.length} palestrantes`;
    } else if (primary) {
      if (primary.role && primary.company) {
        roleCompany = `${primary.role} @ ${primary.company}`;
      } else {
        roleCompany = primary.role || primary.company || '';
      }
    }
    document.getElementById('modal-speaker-role')!.textContent = roleCompany;

    // Data, Hora e Local (mesmos textos do modal de minicurso quando vazios)
    document.getElementById('modal-date')!.textContent = session.dayLabel || 'Data a definir';
    document.getElementById('modal-time')!.textContent = session.timeStart
      ? `${session.timeStart}${session.timeEnd ? ` - ${session.timeEnd}` : ''}`
      : 'Horário a definir';
    document.getElementById('modal-location')!.textContent = session.location || 'Local a definir';

    // Fotos Dinâmicas
    const container = document.getElementById('modal-photo-container')!;
    container.replaceChildren();
    if (modalInterval) clearInterval(modalInterval);

    const allPhotos: string[] = session.speakers.flatMap(photosOf);

    if (allPhotos.length === 0) {
      const empty = document.createElement('div');
      empty.className =
        'flex h-full w-full items-center justify-center bg-[var(--card-bg)] text-xs text-[var(--text-secondary)]';
      empty.textContent = 'Sem foto';
      container.append(empty);
    } else {
      allPhotos.forEach((url, idx) => {
        const img = document.createElement('img');
        img.src = url;
        img.alt = ''; // o nome do palestrante já aparece ao lado
        img.className = `modal-slide-img absolute inset-0 h-full w-full object-cover object-top transition-opacity duration-700 ease-in-out ${idx === 0 ? 'opacity-100' : 'opacity-0'}`;
        container.appendChild(img);
      });

      if (allPhotos.length > 1) {
        let current = 0;
        const slides = container.querySelectorAll<HTMLImageElement>('.modal-slide-img');
        modalInterval = setInterval(() => {
          slides[current].classList.remove('opacity-100');
          slides[current].classList.add('opacity-0');

          current = (current + 1) % slides.length;

          slides[current].classList.remove('opacity-0');
          slides[current].classList.add('opacity-100');
        }, 3000);
      }
    }

    // Descrições
    document.getElementById('modal-description')!.textContent = session.description || 'Sem descrição.';
    document.getElementById('modal-about-label')!.textContent = hasMultiple ? 'os palestrantes' : 'o palestrante';

    renderBios(session.speakers);
  }

  function openModal(sessionId: string) {
    const session = sessions.find((s) => String(s.id) === String(sessionId));
    if (!session || !modal) return;
    fillModal(session);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.dataset.state = 'open';
    document.body.classList.add('modal-open');
    if (panel) panel.scrollTop = 0;
    a11y.activate();
  }

  function closeModal() {
    if (!modal || modal.dataset.state !== 'open') return;
    if (modalInterval) clearInterval(modalInterval);
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.dataset.state = 'closed';
    document.body.classList.remove('modal-open');
    a11y.deactivate();
  }

  document.addEventListener('click', (event) => {
    const trigger = (event.target as HTMLElement)?.closest('[data-session-trigger]');
    if (trigger instanceof HTMLElement) {
      const id = trigger.dataset.sessionTrigger;
      if (id) openModal(id);
    }
  });

  // Clique fora do painel e dos links (fundo escuro ou área transparente em volta) fecha
  modal?.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target || !target.isConnected) return;
    if (panel?.contains(target) || target.closest('.link-chip')) return;
    closeModal();
  });
  closeBtn?.addEventListener('click', closeModal);
</script>

<style>
  /* Abas de palestrantes (criadas via JS, por isso :global) */
  #modal-bio :global(.bio-tab) {
    border-color: var(--border-color);
    color: var(--text-secondary);
  }
  #modal-bio :global(.bio-tab:hover) {
    color: var(--text-primary);
  }
  #modal-bio :global(.bio-tab-active) {
    border-color: color-mix(in oklab, var(--color-accent) 70%, transparent);
    background-color: color-mix(in oklab, var(--color-accent) 15%, transparent);
    color: var(--text-primary);
  }
</style>

