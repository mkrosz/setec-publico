---
type NavIconName = 'home' | 'mic' | 'calendar';

interface NavItem {
  label: string;
  href: string;
  icon: NavIconName;
}

const navItems: NavItem[] = [
  { label: 'Início', href: '/', icon: 'home' },
  { label: 'Palestrantes', href: '/#palestrantes', icon: 'mic' },
  { label: 'Programação', href: '/programacao', icon: 'calendar' },
];

const currentPath = Astro.url.pathname;

const iconPaths: Record<NavIconName, string> = {
  home: 'M3 11.5 12 4l9 7.5M5 10v9.5a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10',
  mic: 'M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm6-3a6 6 0 0 1-12 0M12 18v3',
  calendar:
    'M7 3v3M17 3v3M4 8.5h16M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5Z',
};
---

<nav
  class="fixed bottom-4 left-1/2 z-40 flex -translate-x-1/2 items-center gap-0.5 rounded-full border border-[var(--border-color)] bg-[var(--nav-bg)] p-1.5 text-xs text-[var(--text-secondary)] shadow-2xl backdrop-blur-xl transition-all duration-300 sm:gap-1 sm:p-2 sm:text-sm"
  aria-label="Navegação principal"
>
  {
    navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          data-nav-link
          data-href={item.href}
          class:list={[
            'relative flex items-center gap-1.5 rounded-full px-3.5 py-2 font-medium transition-all duration-300 ease-out sm:px-4',
            isActive
              ? 'bg-[var(--nav-active-bg)] text-[var(--nav-active-text)] shadow-md scale-105'
              : 'text-[var(--text-secondary)] hover:bg-white/10 hover:text-[var(--text-primary)] hover:scale-105 active:scale-95',
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            class="h-4 w-4 shrink-0 transition-transform duration-300"
          >
            <path
              d={iconPaths[item.icon]}
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="hidden sm:inline">{item.label}</span>
        </a>
      );
    })
  }

  <span class="mx-1 h-5 w-px bg-[var(--border-color)]" aria-hidden="true"></span>

  <!-- Ícone Sympla -->
  <a
    href="https://www.sympla.com.br"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Sympla"
    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-[var(--text-secondary)] transition-all duration-300 hover:bg-white/10 hover:text-[var(--text-primary)] hover:scale-110 active:scale-95"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
      <path
        d="M4 9a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1.5a1.5 1.5 0 0 0 0 3V15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1.5a1.5 1.5 0 0 0 0-3V9Z"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </a>

  <!-- Ícone Instagram -->
  <a
    href="https://instagram.com/setecfatec"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Instagram"
    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-[var(--text-secondary)] transition-all duration-300 hover:bg-white/10 hover:text-[var(--text-primary)] hover:scale-110 active:scale-95"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4">
      <path
        d="M7 3.5h10A3.5 3.5 0 0 1 20.5 7v10a3.5 3.5 0 0 1-3.5 3.5H7A3.5 3.5 0 0 1 3.5 17V7A3.5 3.5 0 0 1 7 3.5ZM12 8.3a3.7 3.7 0 1 0 0 7.4 3.7 3.7 0 0 0 0-7.4ZM16.9 7.1h.01"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
  </a>

  <!-- Botão Alternar Tema -->
  <button
    type="button"
    id="theme-toggle"
    aria-label="Alternar tema claro/escuro"
    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-[var(--text-secondary)] transition-all duration-300 hover:bg-white/10 hover:text-[var(--text-primary)] hover:scale-110 active:scale-95 cursor-pointer"
  >
    <!-- Ícone Lua (Modo Escuro) -->
    <svg id="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 transition-transform duration-300">
      <path
        d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </svg>
    <!-- Ícone Sol (Modo Claro) -->
    <svg id="theme-icon-light" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="hidden h-4 w-4 transition-transform duration-300">
      <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  </button>
</nav>

<script>
  function setupNavbar() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const palestrantesSection = document.getElementById('palestrantes');

    function setActive(activeHref: string) {
      links.forEach((link) => {
        const isTarget = link.getAttribute('data-href') === activeHref;
        if (isTarget) {
          link.classList.add('bg-[var(--nav-active-bg)]', 'text-[var(--nav-active-text)]', 'shadow-md', 'scale-105');
          link.classList.remove('text-[var(--text-secondary)]', 'hover:bg-white/10', 'hover:text-[var(--text-primary)]');
        } else {
          link.classList.remove('bg-[var(--nav-active-bg)]', 'text-[var(--nav-active-text)]', 'shadow-md', 'scale-105');
          link.classList.add('text-[var(--text-secondary)]', 'hover:bg-white/10', 'hover:text-[var(--text-primary)]');
        }
      });
    }

    if (palestrantesSection && window.location.pathname === '/') {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActive('/#palestrantes');
            } else if (window.scrollY < palestrantesSection.offsetTop - 200) {
              setActive('/');
            }
          });
        },
        { threshold: 0.3 }
      );

      observer.observe(palestrantesSection);
    }

    const themeToggle = document.getElementById('theme-toggle');
    const darkIcon = document.getElementById('theme-icon-dark');
    const lightIcon = document.getElementById('theme-icon-light');

    function updateTheme(isLight: boolean) {
      document.documentElement.classList.toggle('light', isLight);
      document.documentElement.classList.toggle('dark', !isLight);

      if (isLight) {
        darkIcon?.classList.add('hidden');
        lightIcon?.classList.remove('hidden');
      } else {
        darkIcon?.classList.remove('hidden');
        lightIcon?.classList.add('hidden');
      }
    }

    const savedTheme = localStorage.getItem('theme');
    const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
    const initialLight = savedTheme === 'light' || (!savedTheme && prefersLight);

    updateTheme(initialLight);

    if (themeToggle) {
      themeToggle.onclick = () => {
        const isCurrentLight = document.documentElement.classList.contains('light');
        const nextLight = !isCurrentLight;
        localStorage.setItem('theme', nextLight ? 'light' : 'dark');
        updateTheme(nextLight);
      };
    }
  }

  setupNavbar();

  document.addEventListener('astro:page-load', setupNavbar);
</script>
