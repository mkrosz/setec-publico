---
import { getEventInfo } from '@/lib/data';
import type { EventInfo } from '@/lib/types';

type NavIconName = 'home' | 'mic' | 'calendar';

interface NavItem {
  label: string;
  href: string;
  icon: NavIconName;
}

interface Props {
  event?: EventInfo;
}

const event = Astro.props.event ?? (await getEventInfo());

// Com o evento oculto, Palestrantes e Programação não têm conteúdo para mostrar
const navItems: NavItem[] = [
  { label: 'Início', href: '/', icon: 'home' },
  ...(event.eventoAtivo
    ? ([
        { label: 'Palestrantes', href: '/#palestrantes', icon: 'mic' },
        { label: 'Programação', href: '/programacao', icon: 'calendar' },
      ] as NavItem[])
    : []),
];

const currentPath = Astro.url.pathname;

const iconPaths: Record<NavIconName, string> = {
  home: 'M3 11.5 12 4l9 7.5M5 10v9.5a1 1 0 0 0 1 1h4v-6h4v6h4a1 1 0 0 0 1-1V10',
  mic: 'M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm6-3a6 6 0 0 1-12 0M12 18v3',
  calendar:
    'M7 3v3M17 3v3M4 8.5h16M5 5.5h14A1.5 1.5 0 0 1 20.5 7v12A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V7A1.5 1.5 0 0 1 5 5.5Z',
};

const inactiveClasses =
  'text-[var(--text-secondary)] hover:bg-white/10 [.light_&]:hover:bg-black/5 hover:text-[var(--text-primary)] hover:scale-105 active:scale-95';
const iconButton =
  'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-[var(--text-secondary)] transition-all duration-300 hover:bg-white/10 [.light_&]:hover:bg-black/5 hover:text-[var(--text-primary)] hover:scale-110 active:scale-95';
---

<nav
  class="fixed bottom-4 left-1/2 z-40 flex -translate-x-1/2 items-center gap-0.5 rounded-full border border-[var(--border-color)] bg-[var(--nav-bg)] p-1.5 text-xs text-[var(--text-secondary)] shadow-2xl backdrop-blur-xl transition-all duration-300 sm:gap-1 sm:p-2 sm:text-sm"
  aria-label="Navegação principal"
>
  {
    navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          data-nav-link
          data-href={item.href}
          aria-label={item.label}
          aria-current={isActive ? 'page' : undefined}
          class:list={[
            'relative flex items-center gap-1.5 rounded-full px-3.5 py-2 font-medium transition-all duration-300 ease-out sm:px-4',
            isActive ? 'bg-[var(--nav-active-bg)] text-[var(--nav-active-text)] shadow-md scale-105' : inactiveClasses,
          ]}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            class="h-4 w-4 shrink-0 transition-transform duration-300"
            aria-hidden="true"
          >
            <path
              d={iconPaths[item.icon]}
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="hidden sm:inline">{item.label}</span>
        </a>
      );
    })
  }

  <span class="mx-1 h-5 w-px bg-[var(--border-color)]" aria-hidden="true"></span>

  {
    event.symplaUrl && (
      <a
        href={event.symplaUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Inscrições no Sympla (abre em nova aba)"
        class={iconButton}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
          <path
            d="M4 9a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v1.5a1.5 1.5 0 0 0 0 3V15a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1.5a1.5 1.5 0 0 0 0-3V9Z"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )
  }

  {
    event.instagramUrl && (
      <a
        href={event.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram (abre em nova aba)"
        class={iconButton}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4" aria-hidden="true">
          <path
            d="M7 3.5h10A3.5 3.5 0 0 1 20.5 7v10a3.5 3.5 0 0 1-3.5 3.5H7A3.5 3.5 0 0 1 3.5 17V7A3.5 3.5 0 0 1 7 3.5ZM12 8.3a3.7 3.7 0 1 0 0 7.4 3.7 3.7 0 0 0 0-7.4ZM16.9 7.1h.01"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )
  }

  <!-- Alternar tema: o ícone segue a classe do <html>, aplicada antes da pintura no Layout -->
  <button
    type="button"
    id="theme-toggle"
    aria-label="Tema claro"
    aria-pressed="false"
    class={`${iconButton} cursor-pointer`}
  >
    <!-- Lua (tema escuro ativo) -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-4 w-4 transition-transform duration-300 [.light_&]:hidden" aria-hidden="true">
      <path
        d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    <!-- Sol (tema claro ativo) -->
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="hidden h-4 w-4 transition-transform duration-300 [.light_&]:block" aria-hidden="true">
      <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
    </svg>
  </button>
</nav>

<script>
  const ACTIVE = ['bg-[var(--nav-active-bg)]', 'text-[var(--nav-active-text)]', 'shadow-md', 'scale-105'];
  const INACTIVE = [
    'text-[var(--text-secondary)]',
    'hover:bg-white/10',
    '[.light_&]:hover:bg-black/5',
    'hover:text-[var(--text-primary)]',
    'hover:scale-105',
    'active:scale-95',
  ];

  function setupNavbar() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
    const palestrantesSection = document.getElementById('palestrantes');

    function setActive(activeHref: string) {
      links.forEach((link) => {
        const isTarget = link.getAttribute('data-href') === activeHref;
        link.classList.remove(...(isTarget ? INACTIVE : ACTIVE));
        link.classList.add(...(isTarget ? ACTIVE : INACTIVE));
        if (isTarget) link.setAttribute('aria-current', activeHref.includes('#') ? 'location' : 'page');
        else link.removeAttribute('aria-current');
      });
    }

    if (palestrantesSection && window.location.pathname === '/') {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setActive('/#palestrantes');
            } else if (window.scrollY < palestrantesSection.offsetTop - 200) {
              setActive('/');
            }
          });
        },
        { threshold: 0.3 }
      );

      observer.observe(palestrantesSection);
    }

    // Tema: mesma chave ('setec-theme') do script do <head> no Layout
    const themeToggle = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const syncPressed = () => themeToggle?.setAttribute('aria-pressed', String(root.classList.contains('light')));
    syncPressed();

    if (themeToggle) {
      themeToggle.onclick = () => {
        const nextLight = !root.classList.contains('light');
        root.classList.toggle('light', nextLight);
        root.classList.toggle('dark', !nextLight);
        try {
          localStorage.setItem('setec-theme', nextLight ? 'light' : 'dark');
        } catch {
          /* navegação privada: o tema vale só nesta página */
        }
        syncPressed();
      };
    }
  }

  setupNavbar();
</script>
